          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Recent:"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "\nFieldwork in Dushanbe and Ishkoshim, Tajikistan (funded by Asia Center, Harvard) 7/3-8/21/14"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "\naffiliated with the University of Central Asia, Dushanbe"
            }
