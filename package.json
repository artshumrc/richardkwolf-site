{
	"name": "richardkwolf-site",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"dev": "pnpm run build && vite dev",
		"build": "vite build && node scripts/generate-static-files.mjs && node scripts/search-index.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"assert:clean-pages": "node scripts/assert-clean-pages.mjs",
		"port:images": "node scripts/port-images.mjs",
		"port:pdfs": "node scripts/port-pdfs.mjs",
		"extract:pages": "node scripts/extract-pages.mjs"
	},
	"dependencies": {
		"leaflet": "^1.9.4",
		"uncial": "^2.0.2",
		"uncial-cms": "^2.0.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/leaflet": "^1.9.22",
		"node-html-parser": "^9.0.4",
		"pagefind": "^1.5.2",
		"sharp": "^0.35.4",
		"svelte": "^5.56.10",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"engines": {
		"node": ">=24"
	}
}
